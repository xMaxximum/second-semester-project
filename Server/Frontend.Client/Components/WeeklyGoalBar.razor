@using Shared.Models
@inject ActivityService ActivityService
@inject WeeklyGoalStorageService WeeklyGoalStorageService
@inject ISnackbar Snackbar

<MudPaper Elevation="3" Class="pa-4 mb-4">

    @if (_loading)
    {
        <MudStack Row="true" Style="align-items: center" Spacing="3">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <MudText Typo="Typo.body2" Class="text--secondary">Loading weekly goal…</MudText>
        </MudStack>
    }
    else
    {
        @if (!_editing)
        {
            <MudStack Row="true" Style="align-items: center" Spacing="4">
                <MudText Typo="Typo.body1" Class="font-weight-medium" Style="min-width: fit-content;">
                    @(_hasGoal ? _goalTitle : "No weekly goal set")
                </MudText>
                
                @if (_hasGoal)
                {
                    <MudProgressLinear Value="@_progressPct"
                                           Color="Color.Primary"
                                           Class="flex-grow-1"
                                           Striped="@(_progressPct < 100)"
                                           Style="height: 6px; border-radius: 3px;"/> 
                    <div class="d-flex gap-2" style="align-items: center">
                        <MudText Typo="Typo.body2" Class="font-weight-medium" Style="min-width: 40px;">
                            @string.Format("{0:0}%", _progressPct)
                        </MudText>
                        <MudText Typo="Typo.body2" Class="font-weight-medium" Style="min-width: 40px;">
                            @_message
                        </MudText>


                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@ToggleEdit"/>

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="DeleteGoal"/>
                    </div>
                }
                else
                {
                    <div class="flex-grow-1"></div>
                    
                    <div class="d-flex gap-2">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Color="Color.Primary" 
                                       Size="Size.Small"
                                       OnClick="@ToggleEdit" />
                    </div>
                }
            </MudStack>
        }
        else
        {
            <MudStack Spacing="3">
                <MudText Typo="Typo.subtitle1" Class="font-weight-medium">
                    @(_hasGoal ? "Edit Goal" : "Create Goal")
                </MudText>

                <MudGrid GutterSize="3">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_goal.Name" 
                                     Label="Goal Name" 
                                     Variant="Variant.Outlined"
                                     Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="double" @bind-Value="_goal.DistanceKm"
                                         Label="Distance (km)" 
                                         Min="0"
                                         Variant="Variant.Outlined"
                                         Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="double" @bind-Value="_goal.TimeHours"
                                         Label="Time (hours)" 
                                         Min="0"
                                         Variant="Variant.Outlined"
                                         Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="double" @bind-Value="_goal.ElevationM"
                                         Label="Elevation (m)" 
                                         Min="0"
                                         Variant="Variant.Outlined"
                                         Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" Class="pt-2">
                        <MudStack Row="true" Style="justify-content: flex-end; align-items: center" Spacing="2">
                            <MudButton Variant="Variant.Text" 
                                      OnClick="CancelEdit"
                                      Size="Size.Small">
                                Cancel
                            </MudButton>
                            <MudButton Variant="Variant.Filled" 
                                      Color="Color.Primary" 
                                      OnClick="SaveGoal"
                                      Size="Size.Small">
                                Save
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudStack>
        }
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _editing = false;
    private bool _hasGoal = false;

    private sealed class WeeklyGoal
    {
        public string Name { get; set; } = "Weekly Goal";
        public double DistanceKm { get; set; } = 0;
        public double TimeHours  { get; set; } = 0;
        public double ElevationM { get; set; } = 0;
    }

    private WeeklyGoal _goal = new();
    private WeeklyGoal _snapshot = new();
    
    private bool MetricsChanged() =>
        !AreEqual(_goal.DistanceKm, _snapshot.DistanceKm) ||
        !AreEqual(_goal.TimeHours,  _snapshot.TimeHours)  ||
        !AreEqual(_goal.ElevationM, _snapshot.ElevationM);

    private static bool AreEqual(double a, double b) =>
        Math.Abs(a - b) < 0.000001;


    private double _progressPct = 0.0;
    private string _goalTitle = "No weekly goal set";
    private string _message = "Set a goal and get started!";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            // Load goal (localStorage)
            var stored = await WeeklyGoalStorageService.GetAsync<WeeklyGoal>("weekly-goal");
            _hasGoal = stored is not null && (stored.DistanceKm > 0 || stored.TimeHours > 0 || stored.ElevationM > 0);
            if (stored is not null) _goal = stored;

            // Load KPI data
            var resp = await ActivityService.GetKpiDataAsync();
            if (resp?.IsSuccess == true && resp.Data is not null)
            {
                MapToView(resp.Data);
            }
            else
            {
                Snackbar.Add(resp?.Message ?? "Could not load KPI data.", Severity.Error);
                BuildFallback();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Weekly Goal: {ex.Message}", Severity.Error);
            BuildFallback();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void BuildFallback()
    {
        _progressPct = 0;
        if (_hasGoal)
        {
            _goalTitle = $"{_goal.Name} • {_goal.DistanceKm:0.#} km • {_goal.TimeHours:0.#} h • {_goal.ElevationM:0} m";
            _message = $"Failed to load progress data";
        }
        else
        {
            _goalTitle = "No weekly goal set";
            _message = "Create a goal to start tracking your progress";
        }
    }

    private static double ParseNumber(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return 0;
        var sb = new System.Text.StringBuilder(s.Length);
        foreach (var ch in s)
            if ((ch >= '0' && ch <= '9') || ch == '.' || ch == ',') sb.Append(ch);
        if (sb.Length == 0) return 0;
        var norm = sb.ToString().Replace(',', '.');
        return double.TryParse(norm, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
    }

    private void MapToView(KpiDataResponse d)
    {
        if (!_hasGoal)
        {
            _progressPct = 0;
            _goalTitle = "No weekly goal set";
            _message = "Create a goal to start tracking your progress";
            return;
        }

        double km   = ParseNumber(d.TotalDistance ?? "");
        double elev = ParseNumber(d.TotalElevation ?? "");
        double timeH;

        var t = d.TotalTime ?? "";
        if (t.IndexOf("min", StringComparison.OrdinalIgnoreCase) >= 0)
            timeH = ParseNumber(t) / 60.0;
        else if (t.Contains(":"))
        {
            var parts = t.Split(':');
            if (parts.Length >= 2 && int.TryParse(parts[0], out var hh) && int.TryParse(parts[1], out var mm))
                timeH = hh + (mm / 60.0);
            else
                timeH = ParseNumber(t);
        }
        else
            timeH = ParseNumber(t);

        double sum = 0; int count = 0;
        if (_goal.DistanceKm > 0) { sum += Clamp01(km   / _goal.DistanceKm) * 100.0; count++; }
        if (_goal.TimeHours  > 0) { sum += Clamp01(timeH / _goal.TimeHours ) * 100.0; count++; }
        if (_goal.ElevationM > 0) { sum += Clamp01(elev / _goal.ElevationM) * 100.0; count++; }

        _progressPct = count > 0 ? (sum / count) : 0;

        _goalTitle = $"{_goal.Name} • {_goal.DistanceKm:0.#} km • {_goal.TimeHours:0.#} h • {_goal.ElevationM:0} m";

        if      (_progressPct < 1)   _message = "Get started!";
        else if (_progressPct < 20)  _message = "Nice start!";
        else if (_progressPct < 50)  _message = "Steady progress!";
        else if (_progressPct < 80)  _message = "Great work!";
        else if (_progressPct < 100) _message = "Final push!";
        else                         _message = "Goal achieved!";
    }

    private static double Clamp01(double v) => v < 0 ? 0 : (v > 1 ? 1 : v);

    private void ToggleEdit()
    {
        if (!_editing)
        {
            _snapshot = new WeeklyGoal
            {
                Name = _goal.Name,
                DistanceKm = _goal.DistanceKm,
                TimeHours = _goal.TimeHours,
                ElevationM = _goal.ElevationM
            };
            _editing = true;
        }
        else
        {
            _goal = _snapshot;
            _editing = false;
        }
    }

    private void CancelEdit()
    {
        _goal = _snapshot;
        _editing = false;
        Snackbar.Add("Changes discarded.", Severity.Info);
    }

    private async Task SaveGoal()
    {
        
        if (_hasGoal && !MetricsChanged())
        {
            Snackbar.Add("Change at least one metric before saving.", Severity.Error);
            return;
        }
        if (!_hasGoal && AreEqual(_goal.DistanceKm, 0) && AreEqual(_goal.TimeHours, 0) && AreEqual(_goal.ElevationM, 0))
        {
            Snackbar.Add("Set at least one metric (distance, time or elevation).", Severity.Error);
            return;
        }
        await WeeklyGoalStorageService.SetAsync("weekly-goal", _goal);
        _hasGoal = (_goal.DistanceKm > 0 || _goal.TimeHours > 0 || _goal.ElevationM > 0);
        _editing = false;
        Snackbar.Add("Weekly goal saved.", Severity.Success);
        await LoadAsync();
    }

    private async Task DeleteGoal()
    {
        _goal = new WeeklyGoal();
        _hasGoal = false;
        _editing = false;

        try { await WeeklyGoalStorageService.RemoveAsync("weekly-goal"); } catch { /* ignore */ }

        Snackbar.Add("Weekly goal deleted.", Severity.Info);
        await LoadAsync();
    }
}
