@using Shared.Models
@inject ActivityService ActivityService
@inject WeeklyGoalStorageService WeeklyGoalStorageService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudPaper Elevation="3" Class="pa-4">
  <MudText Typo="Typo.h4" Color="Color.Primary" Class="icon-header mb-2" Style="font-weight: 600;">
    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large" Class="mr-2"/>
    Achievements
  </MudText>
  <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-primary)" Class="mb-4">
    Earn badges for distance, time, elevation, weekly goals — and a few fun easter eggs
  </MudText>
  <MudDivider Class="mb-2"/>

  <MudStack Row="true" Class="mb-4" Style="justify-content: end;" Gap="2">
    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="@CheckNow">
      Refresh
    </MudButton>
  </MudStack>

  @if (_loading)
  {
    <div class="loading-container">
      <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
      <MudText Typo="Typo.body2" Class="ml-2">Loading achievements...</MudText>
    </div>
  }
  else
  {
    <div class="achievements-grid">
      @foreach (var b in _badges)
      {
        <div class="@($"achievement-card {(b.EarnedAt is not null ? "earned" : "locked")} {(b.IsEasterEgg ? "easter-egg" : "")}")">
          <div class="achievement-header">
            <span class="achievement-icon">@b.Icon</span>
            <div class="achievement-status">
              @if (b.EarnedAt is not null) { <span class="status-earned">✓</span> }
              else { <span class="status-locked">🔒</span> }
            </div>
          </div>

          <div class="achievement-content">
            <h4 class="achievement-title">@b.Title</h4>
            <p class="achievement-description">
              @((b.IsEasterEgg && b.EarnedAt is null) ? "???" : b.Description)
            </p>

            @if (b.EarnedAt is not null)
            {
              <span class="achievement-date">
                @b.EarnedAt.Value.ToLocalTime().ToString("MMM dd, yyyy")
              </span>
            }
          </div>
        </div>
      }
    </div>
  }
</MudPaper>

<style>
  .loading-container {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    color: #666;
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .achievement-card {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 20px;
    transition: all 0.2s ease;
    position: relative;
  }

  .achievement-card:hover {
    border-color: #ccc;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .achievement-card.locked {
    opacity: 0.6;
    background: #fafafa;
  }

  .achievement-card.easter-egg.locked {
    background: linear-gradient(135deg, #fafafa 0%, #f0f0f0 100%);
    border-color: #ddd;
  }

  .achievement-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .achievement-icon {
    font-size: 24px;
    display: block;
  }

  .achievement-status {
    font-size: 14px;
  }

  .status-earned {
    color: #4caf50;
    font-weight: bold;
  }

  .status-locked {
    color: #999;
    font-size: 12px;
  }

  .achievement-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .achievement-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: #333;
    line-height: 1.3;
  }

  .achievement-description {
    margin: 0;
    font-size: 14px;
    color: #666;
    line-height: 1.4;
  }

  .achievement-card.locked .achievement-description {
    color: #999;
  }

  .achievement-date {
    font-size: 12px;
    color: #999;
    margin-top: 4px;
  }

  @@media (max-width: 768px) {
    .achievements-container {
      padding: 16px;
    }

    .achievements-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .achievement-card {
      padding: 16px;
    }
  }

  /* our special toast styles */
  .achv-toast{display:flex;align-items:center;gap:12px;padding:4px 2px}
  .achv-toast__badge{font-size:28px;line-height:1;animation:achv-pop .25s ease-out}
  .achv-toast__text{display:flex;flex-direction:column}
  .achv-toast__title{font-weight:800;font-size:.95rem;letter-spacing:.2px}
  .achv-toast__subtitle{font-size:.85rem;opacity:.95}
  @@keyframes achv-pop{0%{transform:scale(.6);opacity:.2}100%{transform:scale(1);opacity:1}}
  .mud-snackbar-container.mud-snackbar-location-bottom-right{margin:16px}
  .mud-snackbar.mud-alert-success{
    background:linear-gradient(135deg,var(--mud-palette-success) 0%,var(--mud-palette-success-darken) 100%);
    color:#fff;border-radius:14px;box-shadow:0 8px 28px rgba(0,0,0,.18)
  }

  @@media (max-width:768px){.achievements-grid{grid-template-columns:1fr;gap:12px}}
</style>

@code {
  private bool _loading = true;

  // DB state for this week (key: AchievementId, value: EarnedAtUtc)
  private Dictionary<string, DateTime> _earned = new();

  private class WeeklyGoal
  {
    public string Name { get; set; } = "Weekly Goal";
    public double DistanceKm { get; set; }
    public double TimeHours { get; set; }
    public double ElevationM { get; set; }
  }

  private class Badge
  {
    public string Id { get; init; } = "";
    public string Title { get; init; } = "";
    public string Description { get; init; } = "";
    public string Icon { get; init; } = "🏆";
    public Func<KpiDataResponse, WeeklyGoal?, bool> Condition { get; init; } = (_, _) => false;
    public DateTime? EarnedAt { get; set; }
    public bool IsEasterEgg { get; init; } = false;
  }

  private readonly List<Badge> _badges = new();

  protected override async Task OnInitializedAsync() => await LoadAndEvaluate();
  private async Task CheckNow() => await LoadAndEvaluate();

  private async Task LoadAndEvaluate()
  {
    _loading = true;
    try
    {
      var resp = await ActivityService.GetKpiDataAsync();
      if (resp?.IsSuccess != true || resp.Data is null) { Snackbar.Add(resp?.Message ?? "Could not load KPI data for achievements.", Severity.Error); _loading = false; return; }

      var d = resp.Data;
      var goal = await WeeklyGoalStorageService.GetAsync<WeeklyGoal>("weekly-goal");
      _earned = await ActivityService.GetWeeklyAchievementsMapAsync() ?? new Dictionary<string, DateTime>();

      var progress = CalcProgress(d, goal);

      _badges.Clear();
      _badges.AddRange(new[]
      {
        // Progress vs goal
        B("first-step","First Spin","Make any progress (>0%).","🌀",       (_,_) => progress > 0),
        B("twenty","Rolling Start","Reach 20% of your weekly goal.","🎯",  (_,_) => progress >= 20),
        B("halfway","Halfway Hero","Reach 50% of your weekly goal.","💥",  (_,_) => progress >= 50),
        B("ei_hty","Almost There","Reach 80% of your weekly goal.","🧗",   (_,_) => progress >= 80),
        B("_oal-_etter","Goal Getter","Hit 100% of your weekly goal.","🏁",(_,_) => progress >= 100),

        // Distance 
        B("d10","Warm Wheels","Ride 10 km this week.","🚲",         (k,_) => Km(k) >= 10),
        B("d25","Cruiser","Ride 25 km this week.","🚲💯",              (k,_) => Km(k) >= 25),
        B("d42","Marathon Rider","Ride 42 km this week.","🎖️",      (k,_) => Km(k) >= 42),
        B("d50","Fifty-Fifty","Ride 50 km this week.","5️⃣0️⃣",      (k,_) => Km(k) >= 50),
        B("d75","High Roller","Ride 75 km this week.","🎢",          (k,_) => Km(k) >= 75),
        B("d100","Century Rider","Ride 100 km this week.","💯",      (k,_) => Km(k) >= 100),
        B("d150","One-Fifty Club","Ride 150 km this week.","🥇",     (k,_) => Km(k) >= 150),

        // Time
        B("t2h","Time On Saddle","Ride 2 hours this week.","⏱️",     (k,_) => H(k) >= 2),
        B("t5h","Time Lord","Ride 5 hours this week.","⏳",          (k,_) => H(k) >= 5),
        B("t8h","Endurance","Ride 8 hours this week.","🧭",          (k,_) => H(k) >= 8),

        // Elevation
        B("e250","Hill Hopper","Climb 250 m this week.","🏞️",       (k,_) => Elev(k) >= 250),
        B("e500","Climber","Climb 500 m this week.","⛰️",           (k,_) => Elev(k) >= 500),
        B("e1000","Sky Chaser","Climb 1000 m this week.","🗻",       (k,_) => Elev(k) >= 1000),

        // Goal composition
        B("minimalist","The Minimalist","Goal with exactly one metric.","🧘",  (_,g) => g is not null && CountPos(g) == 1),
        B("allrounder","All-Rounder","Goal includes distance, time, and elevation.","🔁", (_,g) => g is not null && CountPos(g) == 3),

        // Easter eggs
        B("earlybird","Early Bird","Open the dashboard before 07:00.","🌅",           (_,_) => DateTime.Now.Hour < 7, true),
        B("nightowl","Night Owl","Open the dashboard after 23:00.","🦉",             (_,_) => DateTime.Now.Hour >= 23, true),
        B("monday","Monday Boost","Open on a Monday.","📅",                          (_,_) => DateTime.Now.DayOfWeek == DayOfWeek.Monday, true),
        B("friday","Friday Vibes","Open on a Friday.","🎉",                           (_,_) => DateTime.Now.DayOfWeek == DayOfWeek.Friday, true),
        B("unicorn","Bikeicorn","Your weekly goal name contains 🦄.","🦄",            (_,g) => (g?.Name ?? string.Empty).Contains("🦄", StringComparison.OrdinalIgnoreCase), true),
        B("secret-7","You Found It!","Open the achievements view 7 times in a row.","🕵️", (_,_) => IncrCounter() >= 7, true),
        B("sundaychill","Sunday Chill","Open on a Sunday.","☕",                      (_,_) => DateTime.Now.DayOfWeek == DayOfWeek.Sunday, true),
        B("rainyday","Rain Rider","Open on a Saturday morning.","🌧️",                (_,_) => DateTime.Now.DayOfWeek == DayOfWeek.Saturday && DateTime.Now.Hour < 12, true),
        B("streak3","3-Day Streak","Open on a day divisible by 3.","🔥",              (_,_) => DateTime.Now.Day % 3 == 0, true),
        B("newmonth","Fresh Start","Open on the 1st day of a month.","📆",            (_,_) => DateTime.Now.Day == 1, true),
        B("lastminute","Last Minute Rider","Open at 23:50 or later.","⌛",             (_,_) => DateTime.Now.Hour == 23 && DateTime.Now.Minute >= 50, true),
        B("devmode","Secret Dev Mode","Your weekly goal name contains 'dev'.","💻",    (_,g) => (g?.Name ?? string.Empty).Contains("dev", StringComparison.OrdinalIgnoreCase), true),
        B("beast","The Beast","Ride at least 99.9 km this week.","👹",                (k,_) => Km(k) >= 99.9, true),
        B("doubletime","Double Trouble","Ride 2.22 hours this week.","✌️",            (k,_) => H(k) >= 2.22, true),
        B("lucky7","Lucky Seven","7 km, 0.7 h, 77 m in one week.","🍀",               (k,_) => Km(k) >= 7 && H(k) >= 0.7 && Elev(k) >= 77, true),
        B("backtothefuture","Back to the Future","Visit from the far future (>2099).","🚀", (_,_) => DateTime.Now.Year > 2099, true),
      });

      foreach (var b in _badges)
      {
        if (_earned.TryGetValue(b.Id, out var ts))
          b.EarnedAt = ts;

        if (b.EarnedAt is null && b.Condition(d, goal))
        {
          var ok = await ActivityService.GrantAchievementAsync(b.Id);
          if (ok)
          {
            b.EarnedAt = DateTime.UtcNow;
            _earned[b.Id] = b.EarnedAt.Value;
            ShowUnlockToast(b.Title, b.Icon);
          }
        }
      }
    }
    catch (Exception ex) { Snackbar.Add($"Achievements: {ex.Message}", Severity.Error); }
    finally { _loading = false; StateHasChanged(); }
  }

  // Toast helper
  private void ShowUnlockToast(string title, string icon)
  {
    var toast = (RenderFragment)(rb =>
    {
      rb.AddMarkupContent(0, $@"
        <div class='achv-toast'>
          <div class='achv-toast__badge'>{icon}</div>
          <div class='achv-toast__text'>
            <div class='achv-toast__title'>Achievement unlocked</div>
            <div class='achv-toast__subtitle'>{title}</div>
          </div>
        </div>");
    });

    var prevPos = Snackbar.Configuration.PositionClass;
    var prevVar = Snackbar.Configuration.SnackbarVariant;

    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
    Snackbar.Configuration.SnackbarVariant = Variant.Filled;
    Snackbar.Configuration.PreventDuplicates = true;
    Snackbar.Configuration.NewestOnTop = true;

    Snackbar.Add(toast, Severity.Success, opt =>
    {
      opt.Action = "View";
      opt.ActionColor = Color.Primary;
      opt.OnClick = _ => { Nav.NavigateTo("/achievements"); return Task.CompletedTask; };
    });

    Snackbar.Configuration.PositionClass = prevPos;
    Snackbar.Configuration.SnackbarVariant = prevVar;
  }

  // helpers
  private static double Km(KpiDataResponse d) => ParseNumber(d.TotalDistance ?? "");
  private static double Elev(KpiDataResponse d) => ParseNumber(d.TotalElevation ?? "");
  private static double H(KpiDataResponse d)
  {
    var t = d.TotalTime ?? "";
    if (t.IndexOf("min", StringComparison.OrdinalIgnoreCase) >= 0) return ParseNumber(t) / 60.0;
    if (t.Contains(':'))
    {
      var p = t.Split(':');
      if (p.Length >= 2 && int.TryParse(p[0], out var hh) && int.TryParse(p[1], out var mm)) return hh + (mm / 60.0);
    }
    return ParseNumber(t);
  }
  private static int CountPos(WeeklyGoal g){int c=0;if(g.DistanceKm>0)c++;if(g.TimeHours>0)c++;if(g.ElevationM>0)c++;return c;}
  private static double ParseNumber(string s)
  {
    if (string.IsNullOrWhiteSpace(s)) return 0;
    Span<char> buf = stackalloc char[s.Length];
    int j = 0;
    foreach (var ch in s) if ((ch >= '0' && ch <= '9') || ch == '.' || ch == ',') buf[j++] = ch;
    if (j == 0) return 0;
    var digits = new string(buf[..j]).Replace(',', '.');
    return double.TryParse(digits, System.Globalization.NumberStyles.Any,
      System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
  }
  private static double Clamp01(double v) => v < 0 ? 0 : (v > 1 ? 1 : v);
  private static double CalcProgress(KpiDataResponse d, WeeklyGoal? g)
  {
    if (g is null) return 0;
    var km = Km(d); var h = H(d); var e = Elev(d);
    double sum = 0; int n = 0;
    if (g.DistanceKm > 0) { sum += Clamp01(km / g.DistanceKm) * 100; n++; }
    if (g.TimeHours > 0)  { sum += Clamp01(h / g.TimeHours) * 100; n++; }
    if (g.ElevationM > 0) { sum += Clamp01(e / g.ElevationM) * 100; n++; }
    return n > 0 ? sum / n : 0;
  }

  // Helper-Factorys -> easterEgg-Flag
  private static Badge B(string id, string title, string desc, string icon,
    Func<KpiDataResponse, WeeklyGoal?, bool> cond, bool easterEgg = false)
      => new() { Id=id, Title=title, Description=desc, Icon=icon, Condition=cond, IsEasterEgg=easterEgg };

  private static Badge B(string id, string title, string desc, string icon,
    Func<KpiDataResponse, bool> cond, bool easterEgg = false)
      => new() { Id=id, Title=title, Description=desc, Icon=icon, Condition=(k,_)=>cond(k), IsEasterEgg=easterEgg };

  private int _openCounter = 0;
  private int IncrCounter() => ++_openCounter;
}
