@inject WeeklyGoalStorageService WeeklyGoalStorageService
@inject ISnackbar Snackbar

<style>
    .chart-card {
        height: 150px;
        align-items: center;
        align-content: center;
    }
</style>

<!-- Weekly Goal Process Bar -->
<MudContainer class="px-8 mt-12 mb-8" MaxWidth="MaxWidth.False">
    <WeeklyGoalBar/>
</MudContainer>

<MudContainer Class=" px-8 mb-16" MaxWidth="MaxWidth.False">
    <MudGrid RowSpacing="3" ColumnSpacing="3">
        <!-- KPI Tiles -->
        <KpiTiles/>

        <!-- Chart Tile -->
        <MudItem xs="12" sm="8" md="4">
            <MudCard Class="pa-4 chart-card" Elevation="3">
                <div style="margin-top: -20px">
                    <WeeklyChart @ref="_weeklyChartRef"/>
                </div>
            </MudCard>
        </MudItem>

        <!-- Weather, CC, Route Planner and Calendar Tiles -->
        <MudItem xs="12" sm="6">
            <MudGrid>
                <MudItem xs="12">
                    <WeatherTile/>
                </MudItem>
                <MudItem xs="12">
                    <CarbsTile/>
                </MudItem>
                <MudItem xs="12">
                    <RoutePlannerTile/>
                </MudItem>
            </MudGrid>
        </MudItem>
        <MudItem xs="12" sm="6">
            <CalenderTile @ref="_calendarRef" />
        </MudItem>

        <!-- Activity Table -->
        <MudItem xs="12" sm="12" md="12">
            <ActivityTable OnActivityCreated="HandleActivityCreated"></ActivityTable>
        </MudItem>

    </MudGrid>
</MudContainer>

@code {
    private bool _toastsShown;
    private CalenderTile? _calendarRef;
    private WeeklyChart? _weeklyChartRef;

    private async Task HandleActivityCreated()
    {
        // Refresh calendar when a new activity is created
        if (_calendarRef != null)
        {
            await _calendarRef.RefreshAsync();
        }
        
        // Refresh weekly chart when a new activity is created
        if (_weeklyChartRef != null)
        {
            await _weeklyChartRef.RefreshAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _toastsShown) return;

        try
        {
            var pending = await WeeklyGoalStorageService.GetAsync<List<string>>("weekly-achievements-pending");
            if (pending is { Count: > 0 })
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Configuration.MaxDisplayedSnackbars = 5;

                foreach (var msg in pending)
                {
                    Snackbar.Add(msg, Severity.Success);
                }
                
                await WeeklyGoalStorageService.RemoveAsync("weekly-achievements-pending");
            }
        }
        catch
        {
            // quietly ignore
        }
        finally
        {
            _toastsShown = true;
        }
    }
}


