@using Heron.MudCalendar
@using Shared.Models
@inject ActivityService ActivityService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<style>
    .mud-cal-toolbar{
        display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:center;
        padding:16px;background:linear-gradient(135deg,var(--mud-palette-primary-lighten) 0%,var(--mud-palette-primary) 100%);
        color:#fff;border-radius:0
    }
    .mud-calendar{border-radius:0}

    .calendar-container{border-radius:8px;overflow:hidden;box-shadow:var(--mud-elevation-6);
        background:var(--mud-palette-surface);display:flex;flex-direction:column}

    .calendar-header{
        background:linear-gradient(135deg,var(--mud-palette-primary) 0%,var(--mud-palette-primary-darken) 100%);
        padding:16px;color:#fff;text-align:center
    }

    .activity-event{
        cursor:pointer;transition:all .2s ease;border-radius:4px;padding:2px 6px;margin:1px 0;
        font-size:.75rem;background:linear-gradient(135deg,var(--mud-palette-success-lighten) 0%,var(--mud-palette-success) 100%);
        color:#fff;border:none
    }
    .activity-event:hover{transform:translateY(-1px);box-shadow:var(--mud-elevation-4);filter:brightness(1.08)}

    .calendar-body{position:relative;flex:1;min-height:420px}
    .cal-fill{height:100%}.cal-fill .mud-calendar{height:100%}
                          
    .week-streak-overlay{
        position:absolute;top:var(--calTop,76px);bottom:var(--calBottom,56px);right:18px;
        width:var(--streakW,40px);display:grid;grid-template-rows:repeat(var(--rows,6),1fr);
        justify-items:end;align-items:center;gap:24px;pointer-events:none;z-index:5
    }
    .week-streak-overlay .chip-holder{pointer-events:auto;display:flex;align-items:center;justify-content:flex-end;width:100%}
    .week-streak-overlay .mud-chip{
        min-width:34px;max-width:54px;padding:0 6px;border-radius:999px;box-shadow:0 4px 14px rgba(104,92,228,.18);
        font-variant-numeric:tabular-nums
    }
    .week-streak-overlay .flame{margin-right:2px;line-height:1}
    .week-streak-overlay .boost{animation:achv-pop .35s ease-out}
    @@keyframes achv-pop{0%{transform:scale(.6);opacity:.2}60%{transform:scale(1.06)}100%{transform:scale(1);opacity:1}}

    .current-streak-chip{position:absolute;top:8px;right:8px;z-index:6;pointer-events:none}
    .current-streak-chip .mud-chip{pointer-events:auto}
    
    .calendar-stats{
        display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;
        padding:12px 16px;background:var(--mud-palette-grey-lighten-5);
        border-top:1px solid var(--mud-palette-divider);border-bottom-left-radius:8px;border-bottom-right-radius:8px
    }
    .stats-left{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .v-sep{width:1px;height:18px;background:var(--mud-palette-divider)}
    .stat-chip{font-variant-numeric:tabular-nums}
    .stat-chip .label{margin-left:6px;opacity:.9;font-size:.75rem}

    @@media (max-width:600px){
        .mud-popover{position:fixed !important;left:50% !important;transform:translateX(-50%) !important}
        .calendar-stats{flex-direction:column;align-items:flex-start}
    }
</style>

<div class="calendar-container">
    <div class="calendar-header">
        <MudText Typo="Typo.h6" Style="font-weight: 600; margin: 0;" Class="icon-header">
            <MudIcon Icon="@Icons.Material.Filled.Event" Style="margin-right: 8px;" />
            Activity Calendar
        </MudText>
    </div>

    <div class="pa-0 calendar-body">
        <MudCalendar T="CalendarItem"
                     Class="pa-0 cal-fill"
                     Elevation="0"
                     ShowDropdownViewSelector="true"
                     ShowDatePicker="true"
                     Items="calendarItems"
                     CellClicked="OnCellClicked"
                     ItemClicked="OnItemClicked"
                     View="_view"
                     ViewChanged="OnViewChanged" />

        @if (_view == CalendarView.Month)
        {
        <div class="week-streak-overlay"
             style="@($"--rows:{_weekRowCount}; --calTop:{_calTop}px; --calBottom:{_calBottom}px; --streakW:40px;")">
            @for (var i = 0; i < _visibleWeeks.Count; i++)
            {
            var row     = _visibleWeeks[i];
            var boosted = i < _boostFlags.Count && _boostFlags[i];
            <div class="chip-holder">
                <MudTooltip Text="@FormatWeek(row.WeekStart, row.WeekEnd)" Arrow="true" Placement="Placement.Left">
                    <MudChip T="int" Value="@row.MaxStreak" Color="Color.Primary" Variant="Variant.Filled" Class="@(boosted ? "boost" : null)">
                        <span class="flame">🔥</span>@row.MaxStreak
                    </MudChip>
                </MudTooltip>
            </div>
            }
        </div>
        }

        @if (_view == CalendarView.Week || _view == CalendarView.Day)
        {
        <div class="current-streak-chip">
            <MudChip T="int" Value="@_currentStreak" Color="Color.Primary" Variant="Variant.Filled" Dense="true" Size="Size.Small">
                <span class="flame">🔥</span>@_currentStreak
            </MudChip>
        </div>
        }
    </div>

    <div class="calendar-stats">
        <div class="stats-left">
            <div class="d-flex align-items-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Success" />
                <MudText Typo="Typo.caption" Style="font-weight: 500;">
                    @_thisMonthCount activities this month
                </MudText>
            </div>

            <div class="v-sep"></div>

            <MudChip T="int" Value="@_currentStreak" Class="stat-chip" Dense="true" Variant="Variant.Filled" Color="Color.Primary">
                <span class="flame">🔥</span>@_currentStreak<span class="label">current</span>
            </MudChip>

            <MudChip T="int" Value="@_bestWeekStreak" Class="stat-chip" Dense="true" Variant="Variant.Outlined" Color="Color.Primary"
                     StartIcon="@Icons.Material.Filled.MilitaryTech">
                @_bestWeekStreak<span class="label">best week</span>
            </MudChip>
            
        </div>

        <div class="d-flex align-items-center gap-1">
            @if (_loading)
            {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <MudText Typo="Typo.caption">Loading…</MudText>
            }
            else
            {
            <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.caption">Updated @_lastRefresh.ToString("HH:mm")</MudText>
            }
        </div>
    </div>
</div>

@code {

private readonly List<CalendarItem> calendarItems = new();
private readonly Dictionary<long, ActivityResponse> _activityLookup = new();

private bool _loading = true;
private DateTime _lastRefresh = DateTime.Now;
private CalendarView _view = CalendarView.Month;

private readonly List<WeekRow> _visibleWeeks = new();
private readonly List<bool> _boostFlags = new();
private readonly Dictionary<DateTime, int> _lastMaxPerWeekStart = new();
private HashSet<DateTime> _activeDays = new();
private int _weekRowCount = 6;
private int _currentStreak = 0;
private int _bestWeekStreak = 0;     
private int _thisMonthCount = 0;


private int _calTop = 76;
private int _calBottom = 56;

private record WeekRow(DateTime WeekStart, DateTime WeekEnd, int MaxStreak);

protected override async Task OnInitializedAsync()
{
await LoadActivities();
RecomputeStreaksForCurrentMonth();
}

public async Task RefreshAsync()
{
await LoadActivities();
StateHasChanged();
}

private async Task LoadActivities()
{
_loading = true;
try
{
var resp = await ActivityService.GetActivitiesAsync(page: 1, pageSize: 200);
if (resp?.IsSuccess != true || resp.Activities is null)
{
Snackbar.Add("Failed to load activities.", Severity.Error);
return;
}

var unique = resp.Activities
.GroupBy(a => a.Id).Select(g => g.First())
.OrderBy(a => a.StartTime).ToList();

_activityLookup.Clear();
foreach (var a in unique) _activityLookup[a.Id] = a;

calendarItems.Clear();
foreach (var a in unique)
{
calendarItems.Add(new CalendarItem
{
Text = string.IsNullOrWhiteSpace(a.Name) ? $"Activity #{a.Id}" : a.Name,
Start = a.StartTime.ToLocalTime(),
End = (a.EndTime ?? a.StartTime.AddHours(1)).ToLocalTime()
});
}

_activeDays = calendarItems.Select(i => i.Start.Date).ToHashSet();

var now = DateTime.Now;
_thisMonthCount = calendarItems.Count(i =>
(i.Start.Month == now.Month && i.Start.Year == now.Year) ||
(i.End?.Month == now.Month && i.End?.Year == now.Year));

_lastRefresh = DateTime.Now;

RecomputeStreaksForCurrentMonth();
}
catch (Exception ex)
{
Snackbar.Add($"Failed to load activities: {ex.Message}", Severity.Error);
}
finally
{
_loading = false;
}
}

private void OnViewChanged(CalendarView v)
{
_view = v;
if (v == CalendarView.Month) RecomputeStreaksForCurrentMonth();
else _currentStreak = ComputeCurrentStreak(_activeDays);
StateHasChanged();
}

private void RecomputeStreaksForCurrentMonth()
{
var now = DateTime.Now;
var monthStart = new DateTime(now.Year, now.Month, 1);
var monthEnd   = monthStart.AddMonths(1).AddDays(-1);

var firstWeekStart = WeekStartMonday(monthStart);
var lastWeekStart  = WeekStartMonday(monthEnd);
_weekRowCount = (int)((lastWeekStart - firstWeekStart).TotalDays / 7) + 1;

_visibleWeeks.Clear();
_boostFlags.Clear();
_bestWeekStreak = 0;

for (int i = 0; i < _weekRowCount; i++)
{
var ws = firstWeekStart.AddDays(i * 7);
var we = ws.AddDays(6);

var max = MaxConsecutiveInRange(_activeDays, ws, we);
if (max > _bestWeekStreak) _bestWeekStreak = max;

var had = _lastMaxPerWeekStart.TryGetValue(ws, out var prev) ? prev : 0;
_boostFlags.Add(max > had);
_lastMaxPerWeekStart[ws] = max;

_visibleWeeks.Add(new WeekRow(ws, we, max));
}

_currentStreak = ComputeCurrentStreak(_activeDays);

_ = Task.Delay(1000).ContinueWith(_ =>
{
for (int i = 0; i < _boostFlags.Count; i++) _boostFlags[i] = false;
InvokeAsync(StateHasChanged);
});
}

private static int ComputeCurrentStreak(HashSet<DateTime> days)
{
int c = 0;
for (var d = DateTime.Today; days.Contains(d); d = d.AddDays(-1)) c++;
return c;
}

private static DateTime WeekStartMonday(DateTime d)
{
var diff = (7 + (d.DayOfWeek - DayOfWeek.Monday)) % 7;
return d.AddDays(-diff).Date;
}

private static int MaxConsecutiveInRange(HashSet<DateTime> days, DateTime start, DateTime end)
{
var max = 0; var cur = 0;
for (var dt = start.Date; dt <= end.Date; dt = dt.AddDays(1))
{
if (days.Contains(dt)) { if (++cur > max) max = cur; }
else cur = 0;
}
return max;
}

private static string FormatWeek(DateTime s, DateTime e) => $"{s:dd.MM.}–{e:dd.MM.}";

private void OnCellClicked(DateTime date)
{
var activitiesOnDate = calendarItems.Where(item =>
item.Start.Date == date.Date || (item.End?.Date == date.Date)).ToList();

if (activitiesOnDate.Any())
Snackbar.Add($"Found {activitiesOnDate.Count} activities on {date:MMM dd}.", Severity.Info);
}

private void OnItemClicked(CalendarItem item)
{
var activity = _activityLookup.Values.FirstOrDefault(a =>
(string.IsNullOrWhiteSpace(a.Name) ? $"Activity #{a.Id}" : a.Name) == item.Text);

if (activity != null) Nav.NavigateTo($"/activity/{activity.Id}");
else Snackbar.Add($"Opening: {item.Text}", Severity.Info);
}
}
