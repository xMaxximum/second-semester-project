@page "/game"
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>🚴‍♂️ Cyclone Escape Game</PageTitle>

<div class="ceg-root">
    <div class="ceg-stage">
        <canvas @ref="_canvas" tabindex="0" aria-label="Cyclone Escape Game"></canvas>

        <div class="ceg-instructions" id="cycloneHelp">
            <h2>🚴‍♂️ CYCLONE ESCAPE!</h2>
            <p><strong>Desktop:</strong> SPACE to jump • ESC to pause</p>
            <p><strong>Mobile:</strong> TAP to jump • DOUBLE TAP to pause</p>
            <ul>
                <li>Avoid trees 🌳, rocks 🪨, cacti 🌵 and barriers 🚧</li>
                <li>Duck under flying birds 🦅🦇🐦 - jumping will hit them!</li>
                <li>Collect power-ups: Shield 🛡️, Multiplier ⭐, Invincible 💎</li>
                <li>Watch the day/night cycle and parallax hills!</li>
                <li>Survive to score. Speed ramps every 75 points.</li>
                <li>Beat your high score!</li>
            </ul>
            <div class="ceg-ctrls">
                <button class="ceg-btn primary" @onclick="Start">🎮 Start Game</button>
                <button class="ceg-btn" @onclick="@(()=> Nav.NavigateTo("/"))">🏠 Go Back</button>
            </div>
        </div>

        <!-- Game Over Screen -->
        <div class="ceg-game-over" id="cycloneGameOver">
            <div class="ceg-game-over-content">
                <h2>💀 GAME OVER! 💀</h2>
                <div class="ceg-score-display">
                    <div class="final-score">Final Score: <span id="finalScore">0</span></div>
                    <div class="high-score">High Score: <span id="gameOverHighScore">0</span></div>
                    <div class="new-high-score" id="newHighScore">🎉 NEW HIGH SCORE! 🎉</div>
                </div>
                <div class="ceg-game-over-buttons">
                    <button class="ceg-btn primary" @onclick="RestartGame">🔄 Play Again</button>
                    <button class="ceg-btn" @onclick="ExitGame">🏠 Exit Game</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="ceg-foot">
        <small class="ceg-foot-full">Desktop: SPACE to jump • ESC to pause | Mobile: TAP to jump • DOUBLE TAP to pause | Collect power-ups for bonuses! 🛡️⭐💎</small>
        <small class="ceg-foot-short">SPACE/TAP: jump • ESC/DOUBLE TAP: pause • Collect: 🛡️⭐💎</small>
    </footer>
</div>

@code
{
    private ElementReference _canvas;
    private IJSObjectReference? _mod;
    private DotNetObjectReference<Game>? _selfRef;

    private int _score, _highScore;
    private double _speed;
    private bool _paused;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _mod = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cycloneGame.js");
        _selfRef = DotNetObjectReference.Create(this);
        await _mod.InvokeVoidAsync("initCycloneGame", _canvas, _selfRef);
    }

    private async Task Start()
    {
        if (_mod is null) return;
        await _mod.InvokeVoidAsync("startCycloneGame");
        _paused = false;
        StateHasChanged();
    }

    private async Task TogglePause()
    {
        if (_mod is null) return;
        _paused = !_paused;
        await _mod.InvokeVoidAsync(_paused ? "pauseCycloneGame" : "resumeCycloneGame");
        StateHasChanged();
    }

    private async Task RestartGame()
    {
        if (_mod is null) return;
        await _mod.InvokeVoidAsync("startCycloneGame");
        _paused = false;
        StateHasChanged();
    }

    private async Task ExitGame()
    {
        if (_mod is null) return;
        await _mod.InvokeVoidAsync("exitGame");
        Nav.NavigateTo("/");
    }

    [JSInvokable("CycloneScoreUpdate")]
    public void OnScore(int score, int high, double speed)
    {
        _score = score;
        _highScore = high;
        _speed = speed;
        StateHasChanged();
    }

    [JSInvokable("CyclonePaused")]
    public void OnPaused(bool isPaused)
    {
        _paused = isPaused;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_mod is not null)
        {
            try { await _mod.InvokeVoidAsync("destroyCycloneGame"); } catch {}
            await _mod.DisposeAsync();
        }
        _selfRef?.Dispose();
    }
}

<style>
.ceg-root{position:fixed;inset:0;top:60px;display:flex;flex-direction:column;background:linear-gradient(to bottom,#87CEEB 0%,#98FB98 70%,#8FBC8F 100%);font-family:system-ui,Segoe UI,Roboto,Arial,sans-serif}
.ceg-foot{background:rgba(0,0,0,.8);color:#fff;padding:10px 14px;display:flex;align-items:center;gap:10px;border-top:2px solid #ffd700;justify-content:center}
.ceg-foot-short{display:none}
.ceg-btn{background:#666;border:none;color:#fff;padding:8px 14px;border-radius:18px;cursor:pointer;font-weight:600;touch-action:manipulation;min-height:44px;min-width:44px;transition:all 0.2s ease}
.ceg-btn:hover{transform:translateY(-1px);box-shadow:0 4px 8px rgba(0,0,0,0.3)}
.ceg-btn:active{transform:translateY(0)}
.ceg-btn.primary{background:#ff6b35}
.ceg-stage{position:relative;flex:1;overflow:hidden;touch-action:none}
canvas{display:block;width:100%;height:100%;touch-action:none;user-select:none;transition:transform 0.1s ease}
.ceg-instructions{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%, -50%);
  width:90%;
  max-width:560px;
  max-height:80vh;
  background:rgba(255,255,255,.96);
  border:3px solid #ffd700;
  border-radius:16px;
  box-shadow:0 8px 32px rgba(0,0,0,.3);
  padding:24px;
  text-align:center;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  overflow-y:auto;
}
.ceg-instructions h2{margin:0 0 8px 0}
.ceg-instructions ul{
  text-align:left;
  margin:8px 0;
  padding-left:20px;
  max-width:100%;
  width:100%;
  box-sizing:border-box;
}
.ceg-ctrls{display:flex;justify-content:center;gap:10px;margin-top:10px;flex-wrap:wrap}

/* Game Over Screen Styles */
.ceg-game-over{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.8);
  display:none;
  align-items:center;
  justify-content:center;
  opacity:0;
  transition:opacity 0.3s ease;
  backdrop-filter:blur(10px);
  z-index:1000;
}
.ceg-game-over.show{opacity:1}
.ceg-game-over-content{
  background:linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
  border:4px solid #ffd700;
  border-radius:20px;
  padding:40px;
  text-align:center;
  color:#fff;
  box-shadow:0 20px 40px rgba(0,0,0,0.5);
  transform:scale(0.8);
  transition:transform 0.3s ease;
  max-width:400px;
  width:90%;
}
.ceg-game-over.show .ceg-game-over-content{transform:scale(1)}
.ceg-game-over h2{
  margin:0 0 20px 0;
  font-size:2.5em;
  text-shadow:2px 2px 4px rgba(0,0,0,0.5);
  animation:pulse 2s infinite;
}
.ceg-score-display{margin:20px 0}
.final-score,.high-score{
  font-size:1.4em;
  margin:10px 0;
  font-weight:bold;
  text-shadow:1px 1px 2px rgba(0,0,0,0.5);
}
.new-high-score{
  color:#ffd700;
  font-size:1.2em;
  font-weight:bold;
  margin:15px 0;
  animation:glow 1s ease-in-out infinite alternate;
  display:none;
}
.ceg-game-over-buttons{
  display:flex;
  gap:15px;
  justify-content:center;
  flex-wrap:wrap;
  margin-top:25px;
}
.ceg-game-over-buttons .ceg-btn{
  padding:12px 20px;
  font-size:16px;
  min-width:120px;
}

/* Animations */
@@keyframes pulse{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.05)}
}
@@keyframes glow{
  from{text-shadow:0 0 5px #ffd700,0 0 10px #ffd700,0 0 15px #ffd700}
  to{text-shadow:0 0 10px #ffd700,0 0 20px #ffd700,0 0 25px #ffd700}
}

/* Responsive Design */
@@media (max-width:600px){
  .ceg-root{top:50px} /* Account for smaller mobile header */
  .ceg-instructions{
    width:calc(100vw - 40px);
    max-width:calc(100vw - 40px);
    padding:20px;
    max-height:calc(100vh - 140px);
  }
  .ceg-instructions h2{font-size:1.8em;margin-bottom:12px}
  .ceg-instructions p{font-size:14px;margin:8px 0;line-height:1.4}
  .ceg-instructions ul{
    font-size:14px;
    line-height:1.5;
    padding-left:18px;
    margin:12px 0;
  }
  .ceg-instructions li{margin:4px 0;word-wrap:break-word}
  .ceg-ctrls{
    flex-direction:column;
    align-items:center;
    gap:12px;
    margin-top:16px;
    width:100%;
  }
  .ceg-btn{
    padding:12px 20px;
    font-size:16px;
    width:100%;
    max-width:250px;
    min-height:48px;
  }
  .ceg-foot{
    font-size:11px;
    padding:6px 8px;
    text-align:center;
    line-height:1.3;
    word-wrap:break-word;
    hyphens:auto;
  }
  .ceg-game-over-content{padding:30px 20px}
  .ceg-game-over h2{font-size:2em}
  .ceg-game-over-buttons{flex-direction:column;align-items:center}
  .ceg-game-over-buttons .ceg-btn{width:100%;max-width:200px}
}
@@media (max-width:400px){
  .ceg-root{top:45px} /* Account for very small mobile header */
  .ceg-instructions{
    width:calc(100vw - 24px);
    max-width:calc(100vw - 24px);
    padding:16px;
    max-height:calc(100vh - 100px);
  }
  .ceg-instructions h2{font-size:1.5em;margin-bottom:10px}
  .ceg-instructions p{font-size:13px;margin:6px 0;line-height:1.3}
  .ceg-instructions ul{
    font-size:13px;
    padding-left:16px;
    margin:10px 0;
  }
  .ceg-instructions li{margin:3px 0;word-wrap:break-word}
  .ceg-ctrls{gap:10px;margin-top:12px;width:100%}
  .ceg-btn{
    padding:12px 16px;
    font-size:15px;
    max-width:100%;
    min-height:46px;
  }
  .ceg-foot{
    font-size:10px;
    padding:4px 6px;
    line-height:1.2;
    word-spacing:-1px;
  }
  .ceg-game-over-content{padding:25px 15px}
  .final-score,.high-score{font-size:1.2em}
}

/* Extra small phones like Samsung S8+ and older devices */
@@media (max-width:360px){
  .ceg-foot{
    font-size:9px;
    padding:3px 4px;
    line-height:1.1;
    word-spacing:-2px;
    letter-spacing:-0.5px;
  }
  .ceg-foot-full{display:none}
  .ceg-foot-short{display:block}
}

/* Ultra small phones */
@@media (max-width:320px){
  .ceg-foot{
    font-size:8px;
    padding:2px 3px;
    line-height:1.0;
    word-spacing:-2px;
    letter-spacing:-1px;
  }
  .ceg-foot-full{display:none}
  .ceg-foot-short{display:block}
}
</style>
