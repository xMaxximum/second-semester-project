@page "/app/achievements"
@inject NavigationManager Navigation



<MudContainer Class="h-screen">
    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ArrowBack"
               Color="Color.Primary" OnClick="GoBack" Size="Size.Small" Class="mb-2">
        Back
    </MudButton>
    <WeeklyAchievements/>
</MudContainer>

@code
{
    private void GoBack()
    {
        Navigation.NavigateTo("/app");
    }
}
