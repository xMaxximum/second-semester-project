@page "/"
@rendermode InteractiveWebAssembly
@using Frontend.Client.Components
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Home</PageTitle>

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            @* Landing page content for logged-in users *@
            <MudContainer MaxWidth="MaxWidth.Large" Class="pa-8" Style="min-height: 80vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
                <div style="max-width: 600px;">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Large" Color="Color.Primary" Class="mb-4" Style="font-size: 4rem;" />
                    <MudText Typo="Typo.h3" Class="mb-4" Color="Color.Primary">Welcome back!</MudText>
                    <MudText Typo="Typo.h6" Class="mb-6" Color="Color.Secondary">Ready to track your cycling activities?</MudText>
                    
                    <MudStack Direction="Row" Spacing="3" Justify="Justify.Center" Class="mb-8" Style="flex-wrap: wrap;">
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Primary" 
                                  Size="Size.Large"
                                  StartIcon="@Icons.Material.Filled.Dashboard"
                                  Href="/app"
                                  Style="min-width: 200px; height: 56px;">
                            Open Dashboard
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" 
                                  Color="Color.Primary" 
                                  Size="Size.Large"
                                  StartIcon="@Icons.Material.Filled.Route"
                                  Href="/app/route-planner"
                                  Style="min-width: 200px; height: 56px;">
                            Plan Route
                        </MudButton>
                    </MudStack>
                    
                    <MudDivider Class="my-6" />
                    
                    <MudStack Direction="Row" Spacing="2" Justify="Justify.Center" AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 0.5rem;">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2" Style="width: 100%; text-align: center;">Quick access:</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Href="/app/carbscounter" StartIcon="@Icons.Material.Filled.Calculate">Carbs Calculator</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Href="/app/achievements" StartIcon="@Icons.Material.Filled.EmojiEvents">Achievements</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Href="/app/profile" StartIcon="@Icons.Material.Filled.AccountCircle">Profile</MudButton>
                    </MudStack>
                </div>
            </MudContainer>
        </Authorized>
        
        <NotAuthorized>
            @* Original landing page content for non-authenticated users *@
            <HomeLoggedOut />
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>
